# Copiá este archivo a .env y completá tus claves:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# --- Obligatorias ---
PINECONE_API_KEY=pcsk_...
# Embeddings text-embedding-3-small (1536 dims). La API de OpenAI requiere
# crédito cargado; indexar todo el corpus consume ~28k tokens (< US$0,001).
OPENAI_API_KEY=sk-...
# Nombre del índice Serverless. src/setup_index.py lo crea si no existe.
INDEX_NAME=fastapi-docs-rag

# --- Opcionales (estos son los defaults) ---
# Namespace = entorno. Separar dev/prod evita que una re-ingesta de prueba
# ensucie las búsquedas de producción.
PINECONE_NAMESPACE=dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Si cambiás el modelo, EMBEDDING_DIM tiene que ser su dimensión de salida y
# hay que usar un INDEX_NAME nuevo (el índice existente queda en 1536).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Similitud coseno mínima del mejor chunk para responder: por debajo, la
# pregunta se considera fuera de la documentación y no se devuelven chunks.
MIN_SIMILITUD=0.38
